# LINE Messaging API — channel access token, from LINE Developers Console
# (Messaging API channel > Messaging API tab > Channel access token)
LINE_CHANNEL_ACCESS_TOKEN=

# Channel Secret — same channel, used to verify incoming webhook requests
LINE_CHANNEL_SECRET=

# Supabase project settings (Project Settings > API)
SUPABASE_URL=
# Use the service_role key (server-only, bypasses RLS). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret that protects /api/cron/reminders. Vercel automatically sends
# this as `Authorization: Bearer <value>` when it invokes a project's own
# Cron Jobs, as long as the env var is named exactly CRON_SECRET.
CRON_SECRET=
